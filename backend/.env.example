PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mtti_campus_db
# Optional: set to /data when using a Railway volume mounted at /data.
STORAGE_ROOT=
# Logs are written under STORAGE_ROOT/logs (on Railway, /data/logs). Override with LOG_DIR if needed.
# LOG_DIR=
# Daily log files older than this many days are removed at startup. Set 0 to disable cleanup.
LOG_RETENTION_DAYS=14

# CHANGE THESE in production
JWT_SECRET=change-me-to-a-long-random-string
# QR_SECRET=optional-separate-secret-for-signing-qr-codes

# Campus geofence: set the REAL MTTI coordinates (and the same values in frontend/.env)
CAMPUS_LAT=-0.0663
CAMPUS_LNG=37.6642
CAMPUS_RADIUS_M=10000

# ---------------------------------------------------------------------------------------------
# EMAIL (password-reset links, password-changed notices, parent alerts)
# Resend sends over HTTPS and works on hosts that block outbound SMTP.
# Create an API key and verify your sending domain at resend.com, then configure:
# EMAIL_PROVIDER=resend, RESEND_API_KEY=re_..., EMAIL_FROM="MTTI Smart Campus <no-reply@your-verified-domain>"
#
# Alternatively, use SMTP locally or with a provider/host that permits outbound SMTP.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=yourname@gmail.com,
# EMAIL_PASS=<Google App password>. Port 465 uses EMAIL_SECURE=true; port 587 false.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Required for Resend; optional for SMTP. Resend requires this sender/domain to be verified.
# EMAIL_FROM="MTTI Smart Campus" <yourname@gmail.com>
# RESEND_API_KEY=

# Production on Railway: add the chosen provider's variables to the backend service's Variables;
# changing them restarts the service. Verify under Administrator > Settings > Email > Send test email.

# The address people open the app at. Password reset links point here, never to a URL from a request.
# For local development, use http://localhost:5173.
FRONTEND_URL=https://mtti-smart-attendance.vercel.app

# Optional limits (per 15 minutes): reset emails per address / per IP, reset attempts per IP
# RESET_EMAIL_LIMIT=5
# RESET_IP_LIMIT=20
# RESET_ATTEMPT_LIMIT=30

# Optional
# LIBRARY_CAPACITY=100
