PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mtti_campus_db
# Optional: set to /data when using a Railway volume mounted at /data.
STORAGE_ROOT=
# Logs are written under STORAGE_ROOT/logs (on Railway, /data/logs). Override with LOG_DIR if needed.
# LOG_DIR=
# Daily log files older than this many days are removed at startup. Set 0 to disable cleanup.
LOG_RETENTION_DAYS=14

# CHANGE THESE in production
JWT_SECRET=change-me-to-a-long-random-string
# QR_SECRET=optional-separate-secret-for-signing-qr-codes

# Campus geofence: set the REAL MTTI coordinates (and the same values in frontend/.env)
CAMPUS_LAT=-0.0663
CAMPUS_LNG=37.6642
CAMPUS_RADIUS_M=10000

# ---------------------------------------------------------------------------------------------
# EMAIL (password-reset links, password-changed notices, parent alerts)
# Local development: copy this file to backend/.env and enter your own SMTP settings.
# Production on Railway: add these variables to the backend service's Variables in Railway;
# editing this example or a local .env does not change the deployed server. Railway restarts
# the service when variables are changed. Verify in the app: Administrator > Settings > Email
# > "Send test email".
#
# Gmail:  EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USER=yourname@gmail.com
#         EMAIL_PASS=<a Google "App password">, not your normal password
#         (Google Account > Security > turn on 2-Step Verification > App passwords)
# Other:  use your provider's SMTP details (Brevo, Mailgun, Outlook, your own domain...).
# Port 465 = secure (set EMAIL_SECURE=true); port 587 = STARTTLS (EMAIL_SECURE=false).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Optional display name + sender; most providers require this to be the same account as EMAIL_USER
# EMAIL_FROM="MTTI Smart Campus" <yourname@gmail.com>

# The address people open the app at. Password reset links point here, never to a URL from a request.
# For local development, use http://localhost:5173.
FRONTEND_URL=https://mtti-smart-attendance.vercel.app

# Passkeys (Face ID, fingerprint, Windows Hello, or device PIN). The browser performs
# biometric verification locally; the server stores only public keys, never biometric data.
# WEBAUTHN_ORIGINS overrides FRONTEND_URL for passkey origin validation. Include each exact
# frontend origin, comma-separated; they must all share the configured RP_ID.
# WEBAUTHN_ORIGINS=https://mtti-smart-attendance.vercel.app
# WEBAUTHN_RP_ID=mtti-smart-attendance.vercel.app
# For local development, use WEBAUTHN_ORIGINS=http://localhost:5173 and WEBAUTHN_RP_ID=localhost.
# WEBAUTHN_RP_NAME=MTTI Smart Campus

# Web Push (notifications can reach subscribed browsers while the app is closed).
# Generate with: npx web-push generate-vapid-keys
# Keep the private key only in backend/Railway environment variables; never use a VITE_ variable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mtti.ac.ke

# Optional limits (per 15 minutes): reset emails per address / per IP, reset attempts per IP
# RESET_EMAIL_LIMIT=5
# RESET_IP_LIMIT=20
# RESET_ATTEMPT_LIMIT=30

# Optional
# LIBRARY_CAPACITY=100
