# Copy to .env and adjust. Every value is optional in development.

# Where the dev server proxies /api and /socket.io (your backend).
VITE_PROXY_TARGET=http://localhost:5000

# Production build only: full backend API URL (leave unset in dev to use the /api proxy).
# VITE_API_BASE_URL=https://api.your-domain.ac.ke/api
# VITE_SOCKET_URL=https://api.your-domain.ac.ke

# Set to 1 to serve the dev server over HTTPS (camera + GPS need HTTPS on phones).
VITE_HTTPS=0

# Campus geofence. MUST match backend/src/config/mttiGPS.js (the server is the authority).
# The shipped defaults (-1.123, 37.123) look like placeholders: replace with the real MTTI coordinates.
VITE_CAMPUS_LAT=-1.123
VITE_CAMPUS_LNG=37.123
VITE_CAMPUS_RADIUS_M=300
